{
  "title": "TrieOH — Front (Web)",
  "uid": "trieoh-front",
  "tags": [
    "trieoh",
    "front"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "title": "Front (Web) tracing",
      "options": {
        "mode": "markdown",
        "content": "Front spans land here once the BFF tracing plan ships (phase 2).\n\nFront spans share the backend `service.name` (per the naming plan) and are tagged `component=web`, so these panels filter to client-side spans only. Until then the panels are empty by design.\n\n- **Recent Traces / Error Traces**: Jaeger search on `service` + `component=web` tag.\n- **Web Trace Volume**: LogsQL stats over Victoria Traces (experimental — verify field names against the live store)."
      },
      "datasource": {
        "type": "datasource",
        "uid": "grafana"
      }
    },
    {
      "id": 2,
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "title": "Recent Traces (web)",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoriatraces-logs"
      },
      "targets": [
        {
          "expr": "{resource_attr:service.name=~\".*-web\"} | stats by (trace_id) max(_time) as _time, count() as spans, any(name) as name | sort by (_time) desc | limit 20 | fields _time, name, trace_id, spans",
          "legendFormat": "__auto"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "title": "Error Traces (web)",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoriatraces-logs"
      },
      "targets": [
        {
          "expr": "{resource_attr:service.name=~\".*-web\"} status_code:\"2\" | sort by (_time) desc | limit 20 | fields _time, name, trace_id, duration",
          "legendFormat": "__auto"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "title": "Web Trace Volume (experimental — LogsQL)",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoriatraces-logs"
      },
      "targets": [
        {
          "expr": "{resource_attr:service.name=~\".*-web\"} | stats by (\"resource_attr:service.name\") count() as traces",
          "legendFormat": "__auto"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_VM",
        "type": "datasource",
        "pluginId": "victoriametrics-metrics-datasource",
        "hide": 2
      },
      {
        "name": "DS_TRACES",
        "type": "datasource",
        "pluginId": "jaeger",
        "hide": 2
      },
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "${DS_VM}"
        },
        "query": "label_values(http_requests_total, job)",
        "label": "Service",
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  }
}